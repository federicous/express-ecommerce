{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sitecnia B2B client configuration",
  "type": "object",
  "required": ["CLIENT_SLUG", "CLIENT_NAME", "PUBLIC_URL", "API_URL"],
  "properties": {
    "CLIENT_SLUG": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2
    },
    "CLIENT_NAME": {
      "type": "string",
      "minLength": 1
    },
    "PUBLIC_URL": {
      "type": "string",
      "format": "uri"
    },
    "API_URL": {
      "type": "string",
      "format": "uri"
    },
    "FEATURE_MANAGEMENT": {
      "type": "boolean",
      "default": false
    }
  }
}
